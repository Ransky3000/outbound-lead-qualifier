# ============================================
# Outbound Lead Qualifier — Required Credentials
# ============================================
# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.
# ============================================

# --- Vapi ---
VAPI_API_KEY=your_vapi_private_api_key
VAPI_ASSISTANT_ID=your_assistant_id
VAPI_PHONE_NUMBER_ID=your_phone_number_id

# --- Google Sheets ---
GOOGLE_SHEET_ID=your_google_sheet_id
# (OAuth2 is configured inside n8n credential manager)

# --- Twilio (for verified caller ID) ---
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFIED_NUMBER=+1XXXXXXXXXX

# --- OpenAI (used by Vapi internally) ---
OPENAI_API_KEY=your_openai_api_key

# --- n8n Instance ---
N8N_BASE_URL=https://your-n8n-instance.com
