    {
      "parameters": {
        "jsCode": "// Get all input items\nconst items = $input.all();\n\n// Process each item\nreturn items.map(item => {\n  const originalInput = String(item.json['Phone Number'] || '').trim();\n  \n  // Convert to string and remove all non-digit characters\n  let cleanNumber = originalInput.replace(/\\D/g, '');\n  \n  let standardizedNumber = 'incorrect format';\n  \n  // If the original input started with a plus sign, preserve international routing\n  if (originalInput.startsWith('+')) {\n    if (cleanNumber.startsWith('63') && cleanNumber.length === 12) {\n      standardizedNumber = '+' + cleanNumber;\n    } else if (cleanNumber.startsWith('1') && cleanNumber.length === 11) {\n      standardizedNumber = '+' + cleanNumber;\n    } else {\n      standardizedNumber = '+' + cleanNumber;\n    }\n  } else {\n    // Domestic or un-prefixed numbers\n    if (cleanNumber.startsWith('09') && cleanNumber.length === 11) {\n      // Domestic PH mobile: 09171234567 -> +639171234567\n      standardizedNumber = '+63' + cleanNumber.slice(1);\n    } else if (cleanNumber.startsWith('639') && cleanNumber.length === 12) {\n      // PH mobile starting with 639: 639171234567 -> +639171234567\n      standardizedNumber = '+' + cleanNumber;\n    } else if (cleanNumber.startsWith('1') && cleanNumber.length === 11) {\n      // US number with leading 1: 14155552671 -> +14155552671\n      standardizedNumber = '+' + cleanNumber;\n    } else if (cleanNumber.length === 10) {\n      if (cleanNumber.startsWith('9')) {\n        // PH mobile without leading 0: 9473702512 -> +639473702512\n        standardizedNumber = '+63' + cleanNumber;\n      } else {\n        // 10-digit number defaults to US: 4155552671 -> +14155552671\n        standardizedNumber = '+1' + cleanNumber;\n      }\n    } else {\n      standardizedNumber = 'incorrect format';\n    }\n  }\n  \n  return {\n    json: {\n      ...item.json,\n      'Phone Number': standardizedNumber\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
