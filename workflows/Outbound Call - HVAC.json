    {
      "parameters": {
        "jsCode": "const structuredOutputs = $json.artifact?.structuredOutputs || {};\n\n// Vapi keys structured outputs by UUID, but each entry carries its own\n// stable 'name' — look up by name so this survives assistant rebuilds\n// that regenerate UUIDs (see docs/api-contracts.md).\nconst get = (name) => {\n  const entry = Object.values(structuredOutputs).find((v) => v?.name === name);\n  return entry?.result || '';\n};\n\nconst scope = get('scope_of_call');\nconst type = get('system_type');\nconst qty = get('unit_quantity');\nconst time = get('preferred_time');\nconst urgency = get('urgency');\nconst callStatus = get('call_status');\n\nlet jobDetails = `${scope}\\n`;\nif (type) jobDetails += `• System Type: ${type}\\n`;\nif (qty) jobDetails += `• Unit Quantity: ${qty}\\n`;\nif (time) jobDetails += `• Preferred time: ${time}\\n`;\n\nreturn {\n  json: {\n    ...$json,\n    jobDetails: jobDetails.trim(),\n    _vapi_urgency: urgency,\n    _vapi_system_type: type,\n    _vapi_call_status: callStatus\n  }\n};"
      },
