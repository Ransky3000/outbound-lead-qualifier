    {
      "parameters": {
        "jsCode": "// Get all input items\nconst items = $input.all();\n\n// Process each item\nreturn items.map(item => {\n  const body = item.json.body || {};\n  \n  const originalName = body.customer_name || item.json['Full Name'] || '';\n  const originalPhone = body.customer_phone || item.json['Phone Number'] || '';\n  const originalEmail = body.customer_email || item.json['Email Address'] || '';\n  const originalLocation = body.service_location || item.json['Service Location'] || '';\n  const originalServiceType = body.service_type || item.json['Service Type'] || '';\n  const originalDetails = body.request_details || item.json['How can we help you?'] || '';\n\n  const originalInput = String(originalPhone).trim();\n  let cleanNumber = originalInput.replace(/\\D/g, '');\n  let standardizedNumber = 'incorrect format';\n  \n  if (originalInput.startsWith('+')) {\n    standardizedNumber = '+' + cleanNumber;\n  } else {\n    if (cleanNumber.startsWith('09') && cleanNumber.length === 11) {\n      standardizedNumber = '+63' + cleanNumber.substring(1);\n    } else if (cleanNumber.startsWith('639') && cleanNumber.length === 12) {\n      standardizedNumber = '+' + cleanNumber;\n    } else if (cleanNumber.startsWith('1') && cleanNumber.length === 11) {\n      standardizedNumber = '+' + cleanNumber;\n    } else if (cleanNumber.length === 10) {\n      if (cleanNumber.startsWith('9')) {\n        standardizedNumber = '+63' + cleanNumber;\n      } else {\n        standardizedNumber = '+1' + cleanNumber;\n      }\n    } else {\n      standardizedNumber = 'incorrect format';\n    }\n  }\n  \n  return {\n    json: {\n      'Full Name': originalName.trim(),\n      'Phone Number': standardizedNumber,\n      'Email Address': originalEmail.trim(),\n      'Service Location': originalLocation.trim(),\n      'Service Type': originalServiceType.trim(),\n      'How can we help you?': originalDetails.trim()\n    }\n  };\n});"
      },
